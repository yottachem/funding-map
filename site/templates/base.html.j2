<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
{% set up = up | default("") %}
<title>{% block title %}{% endblock %} · Non-Dilutive Funding Map</title>
<meta name="description" content="{% block description %}Grant and contract programs for deep tech companies, graded on sourced award size, published success rate and time to cash, with a roadmap picker. Every figure links its source.{% endblock %}">
{% set page_file = self.path() | trim %}
{% if preview %}<meta name="robots" content="noindex">{% else %}<link rel="canonical" href="{{ site_url }}{{ page_file }}">{% endif %}
<meta property="og:type" content="website">
<meta property="og:site_name" content="Non-Dilutive Funding Map">
<meta property="og:title" content="{{ self.title() }} · Non-Dilutive Funding Map">
<meta property="og:description" content="{{ self.description() }}">
<meta property="og:url" content="{{ site_url }}{{ page_file }}">
<link rel="icon" href="{{ up }}icon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style>
/* Shared with the sibling trackers: instrument spec sheet, ruled sections, mono figures, one indigo accent.
   Tokens are redefined for dark mode; charts read them through classes. */
:root { --bg:#f5f4ef; --surface:#fdfcf8; --fg:#1c1f26; --muted:#5d6370; --line:#cdd0d6; --grid:#e4e5e8; --tint:#e6e8ef;
  --s1:#2f4ba0; --s2:#c2571a; --s3:#2f7d5b; --s4:#8a4f9e; --g:#a6abb5; --c0:#dfe4f2; --c2:#8597d0;
  --font-display:"Newsreader",Georgia,serif; --font-body:"IBM Plex Sans","Helvetica Neue",Arial,sans-serif;
  --font-data:"IBM Plex Mono",ui-monospace,Menlo,monospace; color-scheme: light; }
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) { --bg:#13151a; --surface:#1a1d23; --fg:#e7e8ec; --muted:#9ba1ad;
  --line:#343843; --grid:#262a32; --tint:#20242d; --s1:#8ea6f0; --s2:#f0965a; --s3:#6cc59b; --s4:#c99ade; --g:#5d6370;
  --c0:#2a3150; --c2:#5468b0; color-scheme: dark; } }
:root[data-theme="dark"] { --bg:#13151a; --surface:#1a1d23; --fg:#e7e8ec; --muted:#9ba1ad; --line:#343843; --grid:#262a32; --tint:#20242d;
  --s1:#8ea6f0; --s2:#f0965a; --s3:#6cc59b; --s4:#c99ade; --g:#5d6370; --c0:#2a3150; --c2:#5468b0; color-scheme: dark; }
* { box-sizing: border-box; } html { -webkit-text-size-adjust: 100%; }
body { margin: 0; background: var(--bg); color: var(--fg); font: 15px/1.55 var(--font-body); }
a { color: var(--s1); } a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible { outline: 2px solid var(--s1); outline-offset: 2px; }
.preview { background: var(--s2); color: #fff; font: 500 12px/1 var(--font-data); text-transform: uppercase; letter-spacing: .08em; padding: 7px 16px; text-align: center; }
.banner { background: var(--surface); border-bottom: 1px solid var(--s2); color: var(--fg); font-size: 13.5px; padding: 8px 16px; text-align: center; }
.nav { background: var(--surface); border-bottom: 2px solid var(--fg); }
.nav-in { max-width: 1120px; margin: 0 auto; padding: 0 16px; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 16px; min-height: 52px; }
.brand { font: 600 20px/1 var(--font-display); color: var(--fg); text-decoration: none; margin-right: auto; padding-block: 12px; }
.nav a.l { color: var(--muted); text-decoration: none; font-size: 14px; padding-block: 14px; }
.nav a.l:hover, .nav a.l[aria-current="page"] { color: var(--fg); }
main { max-width: 1120px; margin: 0 auto; padding: 20px 16px 48px; }
h1 { font: 400 clamp(30px, 4.6vw, 44px)/1.08 var(--font-display); letter-spacing: -.01em; margin: 8px 0 10px; text-wrap: balance; }
h2 { font: 600 24px/1.2 var(--font-display); margin: 36px 0 6px; padding-top: 10px; border-top: 2px solid var(--fg); }
h3 { font: 600 18px/1.25 var(--font-display); margin: 20px 0 4px; }
.lede { font: 400 19px/1.5 var(--font-display); max-width: 66ch; margin: 0 0 8px; }
.sub { color: var(--muted); font-size: 13.5px; max-width: 80ch; margin: 4px 0 8px; }
.figs { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); border: 1px solid var(--fg); background: var(--surface); margin: 14px 0 4px; }
.fig { padding: 10px 14px; border-right: 1px dashed var(--line); border-bottom: 1px dashed var(--line); min-width: 0; }
.fig b { display: block; font: 500 22px/1.2 var(--font-data); font-variant-numeric: tabular-nums; }
.fig span { font-size: 12.5px; color: var(--muted); display: block; overflow-wrap: anywhere; }
.fig .src { font: 11px var(--font-data); }
.two { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr)); gap: 8px 28px; }
.cw { overflow-x: auto; } .cw .scatter { min-width: 680px; }
.chart { width: 100%; height: auto; display: block; overflow: visible; margin: 6px 0; }
.chart .grid { stroke: var(--grid); stroke-width: 1; } .chart .grid.zero { stroke: var(--muted); }
.chart .tick, .chart .note, .chart .axis { font: 11px var(--font-data); fill: var(--muted); }
.chart .axis { font-size: 12px; fill: var(--fg); }
.chart .bar { fill: var(--s1); } .chart .whisk { stroke: var(--fg); stroke-width: 1.2; }
.scatter circle { stroke: var(--fg); stroke-width: 1.2; fill-opacity: .8; }
.scatter .k-entry { fill: var(--s1); } .scatter .k-follow-on { fill: var(--surface); stroke: var(--s1); stroke-width: 2.2; }
.scatter .lab { font: 500 12.5px var(--font-body); fill: var(--fg); paint-order: stroke; stroke: var(--bg); stroke-width: 3px; }
.scatter a:hover circle, .scatter a:focus circle { stroke-width: 2.8; }
.key { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 12.5px; color: var(--muted); align-items: center; margin: 4px 0; }
.key i { display: inline-block; width: 12px; height: 12px; border: 1px solid var(--fg); vertical-align: -2px; margin-right: 4px; border-radius: 50%; }
.key .k-entry { background: var(--s1); } .key .k-follow-on { background: var(--surface); border: 2px solid var(--s1); }
.key .k-apply { background: var(--s1); border-radius: 0; } .key .k-cash { background: var(--c2); border-color: var(--c2); border-radius: 0; }
.tw { overflow-x: auto; margin: 8px 0 4px; }
table { border-collapse: collapse; font-size: 13.5px; background: var(--surface); border: 1px solid var(--fg); min-width: 100%; }
th, td { padding: 7px 10px; border-bottom: 1px dashed var(--line); text-align: left; vertical-align: top; }
th { font: 500 11px/1.25 var(--font-data); text-transform: uppercase; letter-spacing: .05em; background: var(--tint); border-bottom: 1px solid var(--fg); }
td.n, th.n { text-align: right; font-family: var(--font-data); font-variant-numeric: tabular-nums; white-space: nowrap; }
td.d { font: 12.5px var(--font-data); font-variant-numeric: tabular-nums; white-space: nowrap; }
td small, .meta { display: block; font: 11.5px/1.4 var(--font-data); color: var(--muted); white-space: normal; }
.prog { font-weight: 600; } .prog a { color: var(--fg); text-decoration: none; } .prog a:hover { color: var(--s1); text-decoration: underline; }
.chip { display: inline-block; font: 500 10.5px/1 var(--font-data); text-transform: uppercase; letter-spacing: .05em; padding: 3px 6px; border: 1px solid currentColor; border-radius: 2px; white-space: nowrap; vertical-align: 1px; }
.chip.st-open { color: var(--s3); background: color-mix(in srgb, var(--s3) 10%, transparent); }
.chip.st-upcoming { color: var(--s1); background: color-mix(in srgb, var(--s1) 9%, transparent); }
.chip.st-between-rounds, .chip.st-unknown { color: var(--muted); border-style: dashed; }
.chip.st-paused, .chip.st-closed { color: var(--s2); background: color-mix(in srgb, var(--s2) 9%, transparent); }
.chip.np { color: var(--muted); border-style: dashed; }
.chip.flag { color: var(--s2); }
.chip.fict { color: var(--s4); background: color-mix(in srgb, var(--s4) 10%, transparent); }
.chips { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin: 4px 0; }
.callout { border-left: 3px solid var(--s1); background: var(--surface); padding: 10px 14px; margin: 12px 0; max-width: 86ch; font-size: 14.5px; }
.callout b { font-weight: 600; } .callout.warn { border-left-color: var(--s2); }
.prose { max-width: 72ch; } .prose p, .prose li { margin: 6px 0; } .prose ul, .prose ol { padding-left: 20px; }
details { margin: 6px 0; } summary { cursor: pointer; color: var(--s1); font-size: 14px; }
dl.facts { display: grid; grid-template-columns: max-content 1fr; gap: 6px 18px; margin: 10px 0; max-width: 90ch; font-size: 14.5px; }
dl.facts dt { font: 500 11px/1.9 var(--font-data); text-transform: uppercase; letter-spacing: .05em; color: var(--muted); }
dl.facts dd { margin: 0; overflow-wrap: anywhere; }
@media (max-width: 560px) { dl.facts { grid-template-columns: 1fr; gap: 0; } dl.facts dd { margin-bottom: 8px; } }
ul.src { list-style: none; padding: 0; margin: 8px 0; max-width: 90ch; }
ul.src li { padding: 6px 0 6px 12px; border-left: 2px solid var(--line); margin: 4px 0; font-size: 13.5px; overflow-wrap: anywhere; }
ul.src .k { font: 500 11px var(--font-data); color: var(--muted); margin-right: 6px; }
.filters { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; font-size: 13.5px; margin: 10px 0; padding: 8px 12px; border: 1px solid var(--line); background: var(--surface); }
.filters select { font: inherit; background: var(--bg); color: var(--fg); border: 1px solid var(--line); padding: 3px 6px; }
.filters .count { margin-left: auto; color: var(--muted); font: 12px var(--font-data); }
/* Picker form */
form.pick { border: 1px solid var(--fg); background: var(--surface); padding: 14px 16px; margin: 14px 0; display: grid; gap: 12px 24px;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); }
form.pick fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
form.pick legend, form.pick label.h { font: 500 11px/1.6 var(--font-data); text-transform: uppercase; letter-spacing: .05em; color: var(--muted); display: block; padding: 0; margin-bottom: 2px; }
form.pick .opt { break-inside: avoid; display: flex; gap: 6px; align-items: baseline; font-size: 14px; margin: 3px 0; }
form.pick input[type=number], form.pick select { font: 14px var(--font-body); width: 100%; background: var(--bg); color: var(--fg); border: 1px solid var(--line); padding: 5px 7px; }
form.pick .wide { grid-column: 1 / -1; }
form.pick .cols { columns: 2 220px; column-gap: 20px; }
form.pick .go { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: center; }
button, .btn { font: 600 14px var(--font-body); background: var(--fg); color: var(--bg); border: 1px solid var(--fg); padding: 8px 16px; cursor: pointer; text-decoration: none; display: inline-block; }
.btn.ghost { background: transparent; color: var(--fg); font-weight: 500; }
.ex { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 10px; margin: 10px 0; }
.ex a { display: block; border: 1px solid var(--line); border-left: 3px solid var(--s4); background: var(--surface); padding: 10px 12px; color: var(--fg); text-decoration: none; font-size: 14px; }
.ex a:hover { border-color: var(--s4); } .ex a small { display: block; color: var(--muted); font-size: 12.5px; margin-top: 3px; }
/* Roadmap timeline: one row per dated step, one column per month */
table.tl { font-size: 12px; } table.tl th, table.tl td { padding: 4px 3px; text-align: center; border-left: 1px dashed var(--grid); }
table.tl th.lbl, table.tl td.lbl { text-align: left; min-width: 190px; max-width: 260px; padding-left: 8px; border-left: 0; white-space: normal; }
table.tl th.m { font-size: 10px; letter-spacing: 0; min-width: 34px; }
table.tl td.a { background: var(--s1); color: var(--surface); font: 600 10px var(--font-data); }
table.tl td.c { background: var(--c2); }
table.tl td.a.c { background: linear-gradient(90deg, var(--s1) 50%, var(--c2) 50%); }
table.tl tr.ch td.lbl { padding-left: 22px; color: var(--muted); }
ul.tree { list-style: none; padding-left: 0; margin: 6px 0; }
ul.tree ul.tree { padding-left: 22px; border-left: 2px solid var(--line); margin-left: 6px; }
ul.tree li { margin: 6px 0; }
ul.tree .step { display: inline-block; background: var(--surface); border: 1px solid var(--line); padding: 6px 10px; font-size: 14px; max-width: 86ch; }
ul.tree .step .meta { margin-top: 2px; }
ul.tree ul.tree > li > .step::before { content: "then "; font: 500 11px var(--font-data); text-transform: uppercase; color: var(--muted); }
.foot { border-top: 1px dashed var(--line); }
.foot-in { max-width: 1120px; margin: 0 auto; padding: 16px 16px 28px; font-size: 12.5px; color: var(--muted); display: grid; gap: 4px; }
.foot a { color: inherit; }
.muted { color: var(--muted); }
table.wide { min-width: 860px; }
[hidden] { display: none !important; }
@media (max-width: 620px) { body { font-size: 14.5px; } .lede { font-size: 17px; } .fig b { font-size: 19px; } }
</style>
</head>
<body>
{% if preview %}<div class="preview">Internal preview, not published</div>{% endif %}
{% if paused %}<div class="banner" role="status"><b>Paused:</b> {% for r in paused %}<a href="{{ up }}program/{{ r.id }}.html">{{ r.name }}</a>{{ ", " if not loop.last }}{% endfor %} (as of {{ verified }}). Their dates and odds may not hold.</div>{% endif %}
<nav class="nav" aria-label="Site"><div class="nav-in">
  <a class="brand" href="{{ up }}index.html">Non-Dilutive Funding Map</a>
{% for p, label in nav %}
  <a class="l" href="{{ up }}{{ p }}.html"{% if page == p %} aria-current="page"{% endif %}>{{ label }}</a>
{% endfor %}
  <a class="l" href="{{ repo }}">Code &amp; data</a>
</div></nav>
<main>
{% block body %}{% endblock %}
</main>
<footer class="foot"><div class="foot-in">
  <span>Built {{ built }}. Every size, rate, timing and date links its source; success rates come only from the funder or the SBA, and where none is published the map says so. Dates change: verify each on the funder's page before you plan around it.</span>
  <span>A planning aid, not advice or an eligibility determination. Code MIT, derived data CC-BY-4.0. A personal project by Joshua Ritchey; views are his own.</span>
</div></footer>
{% block script %}{% endblock %}
{% if analytics_token %}<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ analytics_token }}"}'></script>{% endif %}
</body>
</html>
